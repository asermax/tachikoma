{
  "name": "@asermax/tachikoma",
  "version": "3.71.0",
  "type": "module",
  "bin": {
    "tachikoma": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js"
  },
  "files": [
    "dist",
    "drizzle",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asermax/tachikoma.git"
  },
  "homepage": "https://github.com/asermax/tachikoma/tree/pi",
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@grammyjs/auto-retry": "2.0.2",
    "better-sqlite3": "13.0.3",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.45.1",
    "markdown-it": "15.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "4.0.0",
    "smol-toml": "^1.8.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/markdown-it": "~14.1.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "semantic-release": "25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && pnpm tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.3.0",
  "description": "Proactive personal assistant built on the pi agent SDK",
  "license": "MIT"
}
